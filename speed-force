-- ================= POST FX =================
local blur = Instance.new("BlurEffect", Lighting)
blur.Enabled = false

local colorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
colorCorrection.Enabled = false

local TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

-- ================= SOUNDS =================
local soundActivate = Instance.new("Sound", Workspace)
soundActivate.Volume = 1

local soundLoop = Instance.new("Sound", Workspace)
soundLoop.Looped = true
soundLoop.Volume = 0
soundLoop.PlaybackSpeed = 0.15

-- ================= UTILS =================
local function fadeSound(sound, target, duration)
	local start = sound.Volume
	local startTime = tick()
	local id = "Fade_"..math.random()
	RunService:BindToRenderStep(id, 200, function()
		local a = math.clamp((tick()-startTime)/duration,0,1)
		sound.Volume = start + (target-start)*a
		if a >= 1 then
			RunService:UnbindFromRenderStep(id)
			if target == 0 then sound:Stop() end
		end
	end)
end

local function flashScreen(color)
	local gui = Instance.new("ScreenGui", player.PlayerGui)
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false

	local frame = Instance.new("Frame", gui)
	frame.Size = UDim2.new(1,0,1,0)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1
	frame.ZIndex = 999

	TweenService:Create(frame, TweenInfo.new(0.05), {BackgroundTransparency = 0.25}):Play()
	task.wait(0.05)
	TweenService:Create(frame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
	task.delay(0.35, function() gui:Destroy() end)
end

local function cameraShake(time, mag)
	local start = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if tick()-start > time then conn:Disconnect() return end
		camera.CFrame *= CFrame.new(
			(math.random()-0.5)*mag,
			(math.random()-0.5)*mag,
			0
		)
	end)
end

local function setVisuals(enable, color)
	blur.Enabled = true
	colorCorrection.Enabled = true

	TweenService:Create(blur, TWEEN_INFO, {Size = enable and 6 or 0}):Play()
	TweenService:Create(colorCorrection, TWEEN_INFO, {
		Contrast = enable and 0.15 or 0,
		Saturation = enable and 0.15 or 0,
		TintColor = enable and color or Color3.new(1,1,1)
	}):Play()

	if not enable then
		task.delay(0.5,function()
			if not activeFlash then
				blur.Enabled = false
				colorCorrection.Enabled = false
			end
		end)
	end
end

-- ================= TRAILS =================
local function createAllTrails(color)
	for _,part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			local a0 = Instance.new("Attachment", part)
			local a1 = Instance.new("Attachment", part)
			a0.Position = Vector3.new(0,0.3,0)
			a1.Position = Vector3.new(0,-0.3,0)

			local trail = Instance.new("Trail", part)
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.35
			trail.LightEmission = 1
			trail.WidthScale = NumberSequence.new(0.14)
			trail.Color = ColorSequence.new(color, Color3.new(1,1,1))
			trail.Transparency = NumberSequence.new{
				NumberSequenceKeypoint.new(0,0.1),
				NumberSequenceKeypoint.new(1,1)
			}
			table.insert(allTrails, trail)
		end
	end
end

local function destroyAllTrails()
	for _,t in ipairs(allTrails) do if t.Parent then t:Destroy() end end
	table.clear(allTrails)
end

-- ================= AURA =================
local function createAura(flash)
	local intensity = math.clamp(flash.Speed / 200, 1, 3)

	for _,part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			local att = Instance.new("Attachment", part)
			local em = Instance.new("ParticleEmitter", att)
			em.Texture = flash.Particle
			em.Rate = 20 * intensity
			em.Lifetime = NumberRange.new(0.2,0.4)
			em.Speed = NumberRange.new(4,8 * intensity)
			em.Size = NumberSequence.new(1.2 * intensity, 0.4)
			em.Color = ColorSequence.new(flash.Color)
			em.LightEmission = 1
			table.insert(auraEmitters, att)
		end
	end
end

local function destroyAura()
	for _,a in ipairs(auraEmitters) do if a.Parent then a:Destroy() end end
	table.clear(auraEmitters)
end

-- ================= ACTIVATE / DEACTIVATE =================
local function activateFlash(name)
	if activeFlash then deactivateFlash() end
	activeFlash = name
	local f = FLASHES[name]

	humanoid.WalkSpeed = f.Speed
	humanoid.JumpPower = f.Jump
	camera.FieldOfView = f.FOV

	soundActivate.SoundId = f.ActivateSound
	soundLoop.SoundId = f.LoopSound

	setVisuals(true, f.ScreenColor)
	flashScreen(f.ScreenColor)
	cameraShake(0.4, 0.35)

	soundActivate:Play()
	soundLoop:Play()
	fadeSound(soundLoop,1,0.4)

	createAllTrails(f.TrailColor)
	createAura(f)
end

function deactivateFlash()
	if not activeFlash then return end
	activeFlash = nil

	humanoid.WalkSpeed = NORMAL_SPEED
	humanoid.JumpPower = NORMAL_JUMP
	camera.FieldOfView = NORMAL_FOV

	setVisuals(false)
	flashScreen(Color3.new(1,1,1))
	cameraShake(0.3,0.2)

	fadeSound(soundLoop,0,0.5)
	destroyAllTrails()
	destroyAura()
end

