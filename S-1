--[[
    SUBARU HUB - Official Hybrid Script (PC & Mobile)
    Theme: WR Blue & Gold
]]

local splib = loadstring(game:HttpGet("https://raw.githubusercontent.com/as6cd0/SP_Hub/refs/heads/main/splibv2"))()

-- Automatic Platform Detection
local isOnMobile = game:GetService("UserInputService").TouchEnabled

-- Main Window Configuration
local Window = splib:MakeWindow({
    Name = "Subaru Hub",
    HidePremium = false,
    SaveConfig = true,
    Setting = true,
    ToggleIcon = "rbxassetid://111710478062549",
    ConfigFolder = "SubaruHubConfigs",
    CloseCallback = true
})

-- Subaru Branding Theme (WR Blue & Gold)
splib:SetTheme({
    MainColor = Color3.fromRGB(0, 51, 153),      -- Subaru Blue
    AccentColor = Color3.fromRGB(255, 204, 0),   -- Subaru Gold
    BackgroundColor = Color3.fromRGB(15, 15, 15),
    TextColor = Color3.fromRGB(255, 255, 255)
})

--- ### TAB: INFO ### ---
local InfoTab = Window:MakeTab({
    IsMobile = isOnMobile,
    Name = "Info",
    Icon = "rbxassetid://4483345998"
})

InfoTab:AddSection({ Name = "Subaru Hub Status" })
InfoTab:AddLabel("This is Subaru Hub")
InfoTab:AddParagraph("Platform:", isOnMobile and "Mobile Device" or "PC / Emulator")
InfoTab:AddLabel("Version: 1.0.3")
InfoTab:AddLabel("Status: Undetected")

--- ### TAB: COOL (EXTERNAL SCRIPTS) ### ---
local CoolTab = Window:MakeTab({
    IsMobile = isOnMobile,
    Name = "Cool",
    Icon = "rbxassetid://4483345998"
})

CoolTab:AddSection({ Name = "Script Management" })

-- Animation R6 Dropdown
CoolTab:AddDropdown({
    Name = "Animation R6",
    Default = "Select Animation",
    Options = {"Chara"},
    Callback = function(Value)
        if Value == "Chara" then
            pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Zee4625/Blox-Fruits/refs/heads/main/CHARA-NEW!"))()
            end)
        end
    end    
})

-- Flash Dropdown
CoolTab:AddDropdown({
    Name = "Flash",
    Default = "Select Script",
    Options = {"Flash", "Speed Force"},
    Callback = function(Value)
        if Value == "Flash" then
            pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Zee4625/Blox-Fruits/refs/heads/main/Flash1"))()
            end)
        elseif Value == "Speed Force" then
            pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Zee4625/Subaru/refs/heads/main/speed-force"))()
            end)
        end
    end    
})

--- ### TAB: MAIN (PLAYER) ### ---
local MainTab = Window:MakeTab({
    IsMobile = isOnMobile,
    Name = "Main / Player",
    Icon = "rbxassetid://4483345998"
})

MainTab:AddSection({ Name = "Movement Mods" })

MainTab:AddSlider({
    Name = "WalkSpeed",
    Min = 16, Max = 300, Default = 16, Increment = 1,
    ValueName = "km/h",
    Callback = function(Value)
        pcall(function() game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value end)
    end    
})

MainTab:AddSlider({
    Name = "JumpPower",
    Min = 50, Max = 500, Default = 50, Increment = 1,
    ValueName = "Power",
    Callback = function(Value)
        pcall(function() game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value end)
    end    
})

MainTab:AddToggle({
    Name = "Infinite Jump",
    Default = false,
    Callback = function(Value)
        _G.InfJump = Value
        game:GetService("UserInputService").JumpRequest:Connect(function()
            if _G.InfJump then
                pcall(function()
                    game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
                end)
            end
        end)
    end
})

--- ### TAB: MISC ### ---
local MiscTab = Window:MakeTab({
    IsMobile = isOnMobile,
    Name = "Misc",
    Icon = "rbxassetid://4483345998"
})

MiscTab:AddButton({
    Name = "Reset Character",
    Callback = function() game.Players.LocalPlayer.Character:BreakJoints() end
})

MiscTab:AddButton({
    Name = "Rejoin Game",
    Callback = function()
        game:GetService("TeleportService"):Teleport(game.PlaceId, game.Players.LocalPlayer)
    end
})

-- Startup Notification
splib:MakeNotification({
    Name = "Subaru Hub",
    Content = "Successfully loaded for " .. (isOnMobile and "Mobile" or "PC") .. "!",
    Image = "rbxassetid://128979818272596",
    Time = 5
})
