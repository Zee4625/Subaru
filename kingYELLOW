--[[ 
    PROJECT: THE KING IN YELLOW - THE ULTIMATE PSYCHOSIS
    COMBINED VERSION: BLACK SCREEN TYPEWRITER STORY -> WARNINGS -> TOTAL MADNESS
    SPECIAL: INVERSE DISTANCE SCALING (King grows larger as you retreat)
--]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")
local camera = Workspace.CurrentCamera

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)

------------------------------------------------
-- 1. SETUP INTERFAȚĂ (ECRAN NEGRU + POVESTE)
------------------------------------------------
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local blackScreen = Instance.new("Frame", gui)
blackScreen.Size = UDim2.new(1,0,1,0)
blackScreen.BackgroundColor3 = Color3.new(0,0,0)
blackScreen.ZIndex = 10

local storyLabel = Instance.new("TextLabel", gui)
storyLabel.Size = UDim2.new(0.8, 0, 0.5, 0)
storyLabel.Position = UDim2.new(0.1, 0, 0.25, 0)
storyLabel.BackgroundTransparency = 1
storyLabel.TextColor3 = Color3.fromRGB(255, 230, 0)
storyLabel.Font = Enum.Font.Antique
storyLabel.TextScaled = true
storyLabel.ZIndex = 20
storyLabel.Text = ""

local hint = Instance.new("Hint", player.PlayerGui)
hint.Text = "…"

------------------------------------------------
-- 2. SETUP REGE ȘI ATMOSFERĂ
------------------------------------------------
local cc = Instance.new("ColorCorrectionEffect", Lighting)
local blur = Instance.new("BlurEffect", Lighting)
local bloom = Instance.new("BloomEffect", Lighting)
cc.Parent = Lighting
blur.Parent = Lighting

local king = Instance.new("Part", Workspace)
king.Name = "TheKingInYellow"
king.Size = Vector3.new(4, 9, 4)
king.Anchored = true
king.CanCollide = false
king.Transparency = 1 -- Invizibil până la faza de avertizare
king.Position = root.Position + (root.CFrame.LookVector * 50)

local kingGui = Instance.new("BillboardGui", king)
kingGui.Size = UDim2.new(4, 0, 6, 0)
kingGui.AlwaysOnTop = true
local kingImg = Instance.new("ImageLabel", kingGui)
kingImg.Size = UDim2.new(1, 0, 1, 0)
kingImg.BackgroundTransparency = 1
kingImg.Image = "rbxassetid://103848956594627"

------------------------------------------------
-- 3. FUNCȚIE TYPEWRITER
------------------------------------------------
local function typeWrite(text)
    storyLabel.Text = ""
    for i = 1, #text do
        storyLabel.Text = string.sub(text, 1, i)
        local s = Instance.new("Sound", camera)
        s.SoundId = "rbxassetid://9114221327"
        s.Volume = 0.3
        s.PlaybackSpeed = math.random(8, 12)/10
        s:Play()
        Debris:AddItem(s, 0.5)
        task.wait(0.05)
    end
end

------------------------------------------------
-- 4. FUNCȚIA DE NEBUNIE TOTALĂ (MADNESS)
------------------------------------------------
function startMadness()
    local forcedGaze = true
    local gazeStrength = 0

    -- Visual insanity
    cc.Saturation = -1
    cc.Contrast = 6
    cc.TintColor = Color3.fromRGB(255,200,80)
    blur.Size = 15
    Lighting.FogEnd = 50
    Lighting.FogColor = Color3.new(0,0,0)

    -- Sky pulsating colors
    local sky = Instance.new("Sky", Lighting)
    local skybox = "http://www.roblox.com/asset/?id=9425220156"
    for _, dir in pairs({"Up","Dn","Lf","Rt","Bk","Ft"}) do sky["Skybox"..dir] = skybox end
    sky.CelestialBodiesShown = false

    -- Audio insanity
    local madnessSound = Instance.new("Sound", Workspace)
    madnessSound.SoundId = "rbxassetid://1837768517"
    madnessSound.Looped = true
    madnessSound.Volume = 1
    madnessSound.PlaybackSpeed = 0.1
    SoundService.AmbientReverb = Enum.ReverbType.Arena
    Instance.new("DistortionSoundEffect", madnessSound).Level = 1
    Instance.new("ChorusSoundEffect", madnessSound)
    local pitchShift = Instance.new("PitchShiftSoundEffect", madnessSound)
    pitchShift.Octave = 0.5
    madnessSound:Play()

    -- Spawn mii de semne (Original ID)
    local function spawnParts()
        task.spawn(function()
            while true do
                task.wait(0.05)
                for i=1,15 do 
                    local p = Instance.new("Part", Workspace)
                    p.Anchored = true; p.CanCollide = false; p.Size = Vector3.new(3,6,3); p.Transparency = 1
                    p.Position = root.Position + Vector3.new(math.random(-200,200),4,math.random(-200,200))
                    local g = Instance.new("BillboardGui", p)
                    g.Size = UDim2.new(5,0,5,0); g.AlwaysOnTop = true
                    local img = Instance.new("ImageLabel", g)
                    img.Size = UDim2.new(1,0,1,0); img.BackgroundTransparency = 1
                    img.Image = "http://www.roblox.com/asset/?id=12065405755"
                    Debris:AddItem(p, 0.5)
                end
            end
        end)
    end
    spawnParts()

    -- Cryptic messages & Flash colors
    local insanityHint = Instance.new("Hint", player.PlayerGui)
    local crypticMessages = {")(*#@&$)(*@)$)&", "∞ KNOWLEDGE ∞", "CARCOSA SEES", "NO ESCAPE", "THE MASK IS GONE", "EVERYTHING IS WRONG"}

    task.spawn(function()
        while true do
            task.wait(0.03)
            insanityHint.Text = crypticMessages[math.random(1,#crypticMessages)]
            cc.TintColor = Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255))
            cc.Contrast = math.random(6,25)
            blur.Size = 15 + math.random(0,10)
            Lighting.FogColor = Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255))
        end
    end)

    -- Force camera gaze + INVERSE SCALING (Regele crește dacă fugi)
    RunService.RenderStepped:Connect(function(dt)
        local distance = (root.Position - king.Position).Magnitude
        
        -- EFECTUL DE DISTANȚĂ INVERSĂ
        local baseSize = 4
        local scaleFactor = baseSize + (distance * 0.6) -- Cu cât ești mai departe, cu atât Billboard-ul e mai mare
        kingGui.Size = UDim2.new(scaleFactor, 0, scaleFactor * 1.5, 0)

        if forcedGaze then
            gazeStrength = math.clamp(gazeStrength + dt*1.5,0,1)
            local targetCF = CFrame.new(camera.CFrame.Position, king.Position)
            camera.CFrame = camera.CFrame:Lerp(
                targetCF * CFrame.Angles(
                    math.rad(math.random(-15,15)),
                    math.rad(math.random(-15,15)),
                    0
                ),
                gazeStrength*0.7
            )
        end
    end)

    task.delay(15, function()
        player:Kick("The King has claimed your mind. YOU ARE LOST.")
    end)
end

------------------------------------------------
-- 5. SECVENȚA FINALĂ (POVESTE -> AVERTIZARE -> NEBUNIE)
------------------------------------------------
local storyIntro = {
    "*A whisper drifts from the void...*",
    "'Avery stepped into a world that should not exist.'",
    "'Colors bent and twisted as he walked, and shadows whispered secrets.'",
    "'Knowledge pressed against his mind, unbearable, infinite.'",
    "'I watched him. Now I watch you.'",
    "'Do you hear the hum of the city that never was?'",
    "'The mask is gone. You see too much.'",
    "'The Yellow King waits, patient and eternal.'",
    "'Do you feel my gaze upon you?'"
}

local warningMessages = {
    "You feel watched.", "The air feels wrong.", "Something ancient stirs.",
    "Knowledge presses against your mind.", "He is near.", "LOOK AT HIM", "IT IS TOO LATE"
}

task.spawn(function()
    -- PASUL 1: Povestea Typewriter pe Ecran Negru
    for _, msg in ipairs(storyIntro) do
        typeWrite(msg)
        task.wait(3.5)
    end
    
    -- PASUL 2: Tranziție la Realitate
    TweenService:Create(blackScreen, TweenInfo.new(2), {BackgroundTransparency = 1}):Play()
    TweenService:Create(storyLabel, TweenInfo.new(1), {TextTransparency = 1}):Play()
    
    -- PASUL 3: Avertizări progresive
    for i, msg in ipairs(warningMessages) do
        hint.Text = msg
        if i == 5 then -- Când e aproape
            king.Transparency = 0.5
        end
        task.wait(2.5)
    end
    
    -- PASUL 4: NEBUNIA TOTALĂ
    startMadness()
end)
